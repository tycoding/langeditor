{
  "name": "@langeditor/plugin-spreadsheet",
  "version": "0.1.0",
  "description": "Open-source spreadsheet document mode for LangEditor powered by IronCalc.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/plugin.ts",
    "./src/styles/index.css",
    "./dist/index.es.js",
    "./dist/style.css"
  ],
  "main": "./dist/index.es.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "dist",
    "README.md",
    "PRD.md",
    "LICENSE",
    "package.json"
  ],
  "peerDependencies": {
    "@langeditor/core": ">=1.0.0 <2.0.0",
    "@lucide/vue": ">=0.468.0",
    "vue": ">=3.5.0"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@ironcalc/wasm": "^0.8.4",
    "exceljs": "^4.4.0",
    "papaparse": "^5.7.0"
  },
  "devDependencies": {
    "@langeditor/core": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vue-tsc": "^3.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
