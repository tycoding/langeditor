{
  "name": "@langeditor/agent-core",
  "version": "0.1.0",
  "description": "Framework-independent agent loop, tool skill and stream transport contract for LangEditor AI agent workflows.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.es.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "langeditor",
    "ai",
    "agent",
    "tool-calling",
    "streaming",
    "framework-agnostic"
  ],
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.0.0"
  }
}
