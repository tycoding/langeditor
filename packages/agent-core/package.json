{
  "name": "@langeditor/agent-core",
  "version": "1.1.5",
  "description": "Framework-independent agent loop, tool skill and stream transport contract for LangEditor AI agent workflows.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.es.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "langeditor",
    "ai",
    "agent",
    "tool-calling",
    "streaming",
    "framework-agnostic"
  ],
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tycoding/langeditor.git",
    "directory": "packages/agent-core"
  },
  "homepage": "https://langeditor.cn",
  "bugs": {
    "url": "https://github.com/tycoding/langeditor/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
