{
  "name": "@langeditor/react",
  "version": "1.1.5",
  "description": "A thin React adapter for the LangEditor Web Component.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "index.d.ts"
      ]
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "sideEffects": true,
  "peerDependencies": {
    "@langeditor/core": "^1.1.5",
    "react": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tycoding/langeditor.git",
    "directory": "packages/editor-react"
  },
  "homepage": "https://langeditor.cn",
  "bugs": {
    "url": "https://github.com/tycoding/langeditor/issues"
  },
  "devDependencies": {
    "@langeditor/core": "workspace:*"
  }
}
