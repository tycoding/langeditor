{
  "name": "@langeditor/core",
  "version": "1.1.3",
  "private": false,
  "license": "MIT",
  "description": "An AI-first, framework-agnostic editor for JavaScript applications, powered by Tiptap and Web Components.",
  "author": "TyCoding <langchat@outlook.com>",
  "homepage": "https://langeditor.cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TyCoding/langeditor.git"
  },
  "bugs": {
    "url": "https://github.com/TyCoding/langeditor/issues"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build:lib": "vite build && vite build -c vite.mini.config.ts",
    "build:element:bundle": "vite build -c vite.element.config.ts",
    "build:element": "pnpm build:lib && pnpm build:element:bundle",
    "git-commit": "git-cz",
    "type:check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx,.vue src",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx,.vue src --fix",
    "check": "pnpm type:check && pnpm lint && pnpm build:element",
    "push": "pnpm build:element && pnpm publish --no-git-checks --registry https://registry.npmjs.org/",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "keywords": [
    "LangEditor",
    "WYSIWYG",
    "vue",
    "vue.js",
    "web-components",
    "custom-elements",
    "react",
    "svelte",
    "vanilla-js",
    "framework-agnostic",
    "typescript",
    "tiptap",
    "editor",
    "AI editor",
    "AI writing",
    "shadcn ui",
    "wysiwyg",
    "rich text",
    "markdown"
  ],
  "main": "./lib/langeditor.umd.js",
  "module": "./lib/langeditor.es.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/langeditor.es.js",
      "require": "./lib/langeditor.umd.js"
    },
    "./style.css": {
      "import": "./lib/style.css",
      "require": "./lib/style.css"
    },
    "./element": {
      "types": "./lib/src/element/index.d.ts",
      "import": "./lib/langeditor-element.es.js",
      "require": "./lib/langeditor-element.umd.js"
    },
    "./element.css": {
      "import": "./lib/langeditor-element.css",
      "require": "./lib/langeditor-element.css"
    },
    "./mini": {
      "types": "./lib/src/mini.d.ts",
      "import": "./lib/langeditor-mini.es.js",
      "require": "./lib/langeditor-mini.umd.js"
    },
    "./mini.css": {
      "import": "./lib/langeditor-mini.css",
      "require": "./lib/langeditor-mini.css"
    }
  },
  "sideEffects": [
    "./lib/langeditor-element.es.js",
    "./lib/langeditor-element.umd.js",
    "./lib/langeditor-element.css",
    "./lib/style.css"
  ],
  "files": [
    "lib",
    "docs/theming.md",
    "docs/tippy-style-isolation.md",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.14.0",
  "dependencies": {
    "@lucide/vue": "^1.33.0",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-blockquote": "^3.30.2",
    "@tiptap/extension-bold": "^3.30.2",
    "@tiptap/extension-bubble-menu": "^3.30.2",
    "@tiptap/extension-bullet-list": "^3.30.2",
    "@tiptap/extension-character-count": "^3.30.2",
    "@tiptap/extension-code": "^3.30.2",
    "@tiptap/extension-color": "^3.30.2",
    "@tiptap/extension-document": "^3.30.2",
    "@tiptap/extension-dropcursor": "^3.30.2",
    "@tiptap/extension-focus": "^3.30.2",
    "@tiptap/extension-font-family": "^3.30.2",
    "@tiptap/extension-gapcursor": "^3.30.2",
    "@tiptap/extension-hard-break": "^3.30.2",
    "@tiptap/extension-heading": "^3.30.2",
    "@tiptap/extension-highlight": "^3.30.2",
    "@tiptap/extension-history": "^3.30.2",
    "@tiptap/extension-horizontal-rule": "^3.30.2",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-italic": "^3.30.2",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-list-item": "^3.30.2",
    "@tiptap/extension-ordered-list": "^3.30.2",
    "@tiptap/extension-paragraph": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/extension-strike": "^3.30.2",
    "@tiptap/extension-subscript": "^3.30.2",
    "@tiptap/extension-superscript": "^3.30.2",
    "@tiptap/extension-table": "^3.30.2",
    "@tiptap/extension-table-cell": "^3.30.2",
    "@tiptap/extension-table-header": "^3.30.2",
    "@tiptap/extension-table-row": "^3.30.2",
    "@tiptap/extension-task-item": "^3.30.2",
    "@tiptap/extension-task-list": "^3.30.2",
    "@tiptap/extension-text": "^3.30.2",
    "@tiptap/extension-text-align": "^3.30.2",
    "@tiptap/extension-text-style": "^3.30.2",
    "@tiptap/extension-underline": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/suggestion": "^3.30.2",
    "@tiptap/vue-3": "^3.30.2",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hotkeys-js": "^4.0.5",
    "lodash": "^4.18.1",
    "reka-ui": "^2.10.3",
    "tippy.js": "^6.3.7",
    "uplot": "^1.6.32",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.2",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "postcss-prefix-selector": "^2.1.1",
    "prettier": "^3.9.6",
    "prism-code-editor": "^5.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vue": "^3.5.41"
  },
  "browserslist": [
    "chrome >= 88",
    "firefox >= 78",
    "safari >= 14",
    "edge >= 88"
  ],
  "peerDependencies": {
    "vue": ">= 3.0.0"
  }
}
